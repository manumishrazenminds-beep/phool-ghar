# ---- Browser (safe to expose; prefix VITE_) ----
VITE_DATA_PROVIDER=mock               # set to "supabase" once the backend below is ready
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_RAZORPAY_KEY_ID=                 # public key id only
VITE_WHATSAPP_NUMBER=                 # e.g. 919999999999
VITE_SITE_URL=                        # public origin, e.g. https://www.phoolghar.in (canonical, sitemap, Open Graph)
VITE_SPLINE_SCENE=
VITE_VAPID_PUBLIC_KEY=                 # web push public key (npx web-push generate-vapid-keys); leave empty to hide the option
# Delivery map tiles. Default is OpenStreetMap's public server (fine for launch, light use only).
# For real traffic use a keyed provider, e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILES_URL=
VITE_MAP_ATTRIBUTION=

# ---- Server secrets: set with `supabase secrets set`, NEVER in this file or the browser ----
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
# RESEND_API_KEY, NOTIFY_FROM
# WHATSAPP_TOKEN, WHATSAPP_PHONE_ID          (optional, WhatsApp Cloud API)
# SITE_URL, ALLOWED_ORIGINS
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT   (optional, web push; subject like mailto:you@example.com)
# CRON_SECRET                                 (shared secret for scheduled functions)
